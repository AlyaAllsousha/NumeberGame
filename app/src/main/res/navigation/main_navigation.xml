<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/welcomeFragmentNav">

    <fragment
        android:id="@+id/chooseLevelFragmentNav"
        android:name="com.example.composition.presentation.ChooseLevelFragment"
        android:label="fragment_choose_level"
        tools:layout="@layout/fragment_choose_level" >
        <action
            android:id="@+id/action_chooseLevelFragmentNav_to_gameFragment"
            app:destination="@id/gameFragmentNav" />
    </fragment>
    <fragment
        android:id="@+id/welcomeFragmentNav"
        android:name="com.example.composition.presentation.WelcomeFragment"
        android:label="WelcomeFragment" >
        <action
            android:id="@+id/action_welcomeFragment_to_chooseLevelFragment"
            app:destination="@id/chooseLevelFragmentNav" />
    </fragment>
    <fragment
        android:id="@+id/gameFragmentNav"
        android:name="com.example.composition.presentation.game.GameFragment"
        android:label="fragment_game"
        tools:layout="@layout/fragment_game" >
        <action
            android:id="@+id/action_gameFragment_to_gameFinishedFragment"
            app:destination="@id/gameFinishedFragmentNav"
            app:popUpTo="@id/gameFragmentNav"
            app:popUpToInclusive="true" />
        <argument
            android:name="level"
            app:argType="com.example.composition.domain.entity.Level" />
    </fragment>
    <fragment
        android:id="@+id/gameFinishedFragmentNav"
        android:name="com.example.composition.presentation.GameFinishedFragment"
        android:label="fragment_game_finished"
        tools:layout="@layout/fragment_game_finished" >

        <argument
            android:name="game_result"
            app:argType="com.example.composition.domain.entity.GameResult" />
    </fragment>
</navigation>